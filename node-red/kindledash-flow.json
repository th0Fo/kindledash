  {
    "id": "kdantwort",
    "type": "function",
    "z": "kd0000000000tab",
    "name": "Werte als JSON",
    "func": "const schluessel = [\"soc\", \"akkuW\", \"pvW\", \"hausW\", \"netzW\", \"netzQuelle\", \"zustand\", \"minSoc\"];\nconst out = { kindledash: 1, zeit: Date.now() };\nlet neuste = 0;\nfor (const k of schluessel) {\n    const v = flow.get('kd_' + k);\n    if (v && v.w !== null && v.w !== undefined) { out[k] = v.w; neuste = Math.max(neuste, v.t); }\n}\n// 240 heißt: kein Netz am AC-Eingang (Wechselrichterbetrieb)\nif (out.netzQuelle !== undefined) { out.netz = out.netzQuelle === 240 ? 'aus' : 'ein'; }\nout.netzSeit = flow.get('kd_netzSeit') || null;\nout.alter = neuste ? Math.round((Date.now() - neuste) / 1000) : null;\nmsg.payload = out;\nmsg.headers = { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', 'Access-Control-Allow-Origin': '*' };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 460,
    "y": 580,
    "wires": [
      [
        "kdhttpout"
      ]
    ]
  },
